# 忽略编译生成的中间文件
*.o
*.ko
*.mod
*.mod.c
*.order
*.symvers
*.cmd
.tmp_versions/
*.lds
*.usyms

# 忽略 VS Code 配置
.vscode/
.claude/
.codex/
# android build outputs
android/obj/
android/libomp.a
android/libomp.so
obj/
/libs/
windows/__pycache__/
*.pyc
**/.pyinstaller/

# Build dependency files
*.o.d
*.d

# VS Code settings in subdirectories
**/.vscode/

# Local ARM64 test sources and inputs
lsdriver/arm64_tests/*
!lsdriver/arm64_tests/instruction.txt
!lsdriver/arm64_tests/decoder/
!lsdriver/arm64_tests/decoder/*
!lsdriver/arm64_tests/executor/
!lsdriver/arm64_tests/executor/*

# Local ARM64 executor outputs
lsdriver/arm64_tests/executor/*.ko
lsdriver/arm64_tests/executor/*.cpio.gz
lsdriver/arm64_tests/executor/arm64_instruction_table.h

# Android Studio / Gradle / NDK outputs
.gradle/
.idea/
*.iml
local.properties
build/
out/
captures/
.cxx/
.externalNativeBuild/

# Common generated archives and packages
*.apk
*.aab
*.aar

# Common OS junk
.DS_Store
Thumbs.db

# android root-level binaries
android/*.a
android/*.so

# Downloaded cloudflared payload embedded into LS_KTool at build time
android/jni/assets/cloudflared-linux-arm64
